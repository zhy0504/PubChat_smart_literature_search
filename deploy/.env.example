# Copy to deploy/.env on the server and replace every deployment-specific value.
IMAGE_PREFIX=ghcr.io/zhy0504
IMAGE_TAG=latest
WEB_PORT=8000
# Optional external worker image. Pin a known tag or digest for repeatable rollback.
# CELERY_WORKER_IMAGE=wuyuxuan1037/pubchat-celery-worker:latest

POSTGRES_USER=pubchat
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
PROJECT_ENV=production

# Set these according to the model provider used by the worker.
AI_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_GEMINI_PRO_MODEL=google/gemini-3.1-flash-lite-preview
OPENROUTER_GEMINI_FLASH_MODEL=google/gemini-3.1-flash-lite-preview
OPENROUTER_GEMINI_EMBEDDING_MODEL=google/gemini-embedding-2-preview
MAX_REFINEMENT_ATTEMPTS=30
MIN_STUDY_THRESHOLD=100
AI_MAX_WORKERS=60
OUTPUT_LANGUAGE=zh
BATCH_SIZE=600
EMBEDDING_ENABLED=true
